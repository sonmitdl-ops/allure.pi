{
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "backend/**",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/validation-key.txt",
      "dest": "/validation-key.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
